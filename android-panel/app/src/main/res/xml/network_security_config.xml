<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed only for the Pocket Cloud server's names on your Tailscale network, which encrypts
     the connection itself. Everything else keeps Android's default (https only). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">pocket</domain>
        <domain includeSubdomains="true">ts.net</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
